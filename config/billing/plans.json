{
  "version": 1,
  "fallbackPlan": "free",
  "trialDefaults": {
    "fallbackPlan": "free",
    "basePlan": "pro",
    "personalDays": 7,
    "teamDays": 7,
    "teamSeatCap": 4,
    "screenshotCredits": 15,
    "organizedScreenshotExports": 15,
    "teamRoles": ["owner", "editor", "commenter", "viewer"]
  },
  "retentionDefaults": {
    "archiveDownloadWindowDays": 30,
    "largeAssetRetentionDays": 30,
    "lightweightDataRetentionMonths": 12
  },
  "meters": {
    "crawl_pages": "Crawl pages",
    "screenshot_credits": "Screenshot credits",
    "organized_exports": "Organized screenshot exports"
  },
  "screenshotCreditCosts": {
    "desktop_viewport": 1,
    "mobile_viewport": 1,
    "desktop_mobile_viewport_pair": 2,
    "desktop_full_page": 3,
    "mobile_full_page": 2,
    "desktop_mobile_full_page_pair": 5
  },
  "stripe": {
    "portalConfigurationEnv": "STRIPE_BILLING_PORTAL_CONFIGURATION_ID",
    "plans": {
      "pro": {
        "prices": {
          "monthly": {
            "priceEnv": "STRIPE_PRICE_PRO_MONTHLY",
            "interval": "month"
          },
          "yearly": {
            "priceEnv": "STRIPE_PRICE_PRO_YEARLY",
            "priceEnvFallbacks": ["STRIPE_PRICE_PRO_ANNUAL"],
            "interval": "year"
          }
        }
      },
      "studio": {
        "prices": {
          "monthly": {
            "priceEnv": "STRIPE_PRICE_STUDIO_MONTHLY",
            "interval": "month"
          },
          "yearly": {
            "priceEnv": "STRIPE_PRICE_STUDIO_YEARLY",
            "priceEnvFallbacks": ["STRIPE_PRICE_STUDIO_ANNUAL"],
            "interval": "year"
          }
        }
      },
      "agency": {
        "prices": {
          "monthly": {
            "priceEnv": "STRIPE_PRICE_AGENCY_MONTHLY",
            "interval": "month"
          },
          "yearly": {
            "priceEnv": "STRIPE_PRICE_AGENCY_YEARLY",
            "priceEnvFallbacks": ["STRIPE_PRICE_AGENCY_ANNUAL"],
            "interval": "year"
          }
        }
      }
    },
    "addOns": {
      "crawl_pages_1000": {
        "name": "1,000 crawl pages",
        "priceEnv": "STRIPE_PRICE_CRAWL_PAGES_1000",
        "mode": "payment",
        "meter": "crawl_pages",
        "quantity": 1000,
        "resetBehavior": "rollover"
      },
      "screenshot_credits_25": {
        "name": "25 screenshot credits",
        "priceEnv": "STRIPE_PRICE_SCREENSHOT_CREDITS_25",
        "mode": "payment",
        "meter": "screenshot_credits",
        "quantity": 25,
        "resetBehavior": "rollover"
      },
      "screenshot_credits_50": {
        "name": "50 screenshot credits",
        "priceEnv": "STRIPE_PRICE_SCREENSHOT_CREDITS_50",
        "mode": "payment",
        "meter": "screenshot_credits",
        "quantity": 50,
        "resetBehavior": "rollover"
      },
      "screenshot_credits_100": {
        "name": "100 screenshot credits",
        "priceEnv": "STRIPE_PRICE_SCREENSHOT_CREDITS_100",
        "mode": "payment",
        "meter": "screenshot_credits",
        "quantity": 100,
        "resetBehavior": "rollover"
      },
      "organized_exports_10": {
        "name": "10 organized exports",
        "priceEnv": "STRIPE_PRICE_ORGANIZED_EXPORTS_10",
        "mode": "payment",
        "meter": "organized_exports",
        "quantity": 10,
        "resetBehavior": "rollover"
      },
      "seat_1": {
        "name": "1 extra seat",
        "priceEnv": "STRIPE_PRICE_EXTRA_SEAT_1",
        "mode": "payment",
        "meter": "seats",
        "quantity": 1,
        "resetBehavior": "rollover"
      }
    }
  },
