{
  "manifest_version": 3,
  "name": "Vellic Local Scan Helper",
  "version": "0.1.0",
  "description": "Explicitly connect one selected site's session to an isolated local Vellic scan.",
  "permissions": [
    "cookies",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:4349/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost:4399/*"
  ],
  "action": {
    "default_title": "Connect this site to local Vellic"
  },
  "background": { "service_worker": "worker.js" },
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:4349;"
  },
  "key": ""
}
